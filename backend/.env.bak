# FastAPI Backend
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=englishtest_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# JWT Authentication
SECRET_KEY=7e981215aacbd7264f00547eea00aafc
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (localhost:80 = Caddy, localhost:5173 = Vite dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:80,http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:80,http://entest.almv.kz,https://entest.almv.kz,http://testalmv.kz,https://testalmv.kz

# Database URLs (must match POSTGRES_* above)
DATABASE_URL=postgresql://user:password@db:5432/englishtest_db
ASYNC_DATABASE_URL=postgresql+asyncpg://user:password@db:5432/englishtest_db

# Redis (compose overrides to redis container)
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=20

CACHE_DEFAULT_TTL=300
CACHE_MAX_SIZE=1000
SLOW_REQUEST_THRESHOLD=1.0
MAX_REQUEST_SIZE=10485760
DEFAULT_RATE_LIMIT=60
BURST_RATE_LIMIT=10

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

