# FastAPI Backend
#PORT=8000
#FASTAPI_ENV=development

# PostgreSQL Database
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=englishtest_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Azure OpenAI Specific Configuration
#AZURE_OPENAI_ENDPOINT="https://kaisa-mckqk9jx-eastus2.cognitiveservices.azure.com/"
#AZURE_OPENAI_API_KEY=token
#AZURE_OPENAI_MODEL_NAME=gpt-4o-mini
#AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
#AZURE_OPENAI_API_VERSION=2025-03-01-preview

# Azure OpenAI Audio Services (TTS и GPT-4o-transcribe)
#AZURE_OPENAI_ENDPOINT_AUDIO="https://kaisa-mckqk9jx-eastus2.cognitiveservices.azure.com/"
#AZURE_OPENAI_API_KEY_AUDIO=your_azure_openai_audio_api_key_here
#AZURE_OPENAI_TTS_DEPLOYMENT=gpt-4o-mini-tts
#AZURE_OPENAI_TRANSCRIBE_DEPLOYMENT=gpt-4o-transcribe
#AZURE_OPENAI_AUDIO_API_VERSION=2025-03-01-preview
#AZURE_OPENAI_TTS_API_VERSION="2025-03-01-preview"


# JWT Authentication
SECRET_KEY="your-secret-key"
#ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings (comma-separated list of allowed origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"

# Database URLs (должны совпадать с POSTGRES_* выше)
DATABASE_URL="postgresql://user:password@db:5432/englishtest_db"
ASYNC_DATABASE_URL="postgresql+asyncpg://user:password@db:5432/englishtest_db"

# Redis Configuration
REDIS_URL="redis://redis:6379/0"
REDIS_MAX_CONNECTIONS=20

# Cache Settings
CACHE_DEFAULT_TTL=300
CACHE_MAX_SIZE=1000

# Performance Settings
SLOW_REQUEST_THRESHOLD=1.0
MAX_REQUEST_SIZE=10485760

# Rate Limiting
DEFAULT_RATE_LIMIT=60
BURST_RATE_LIMIT=10

# Celery Configuration
CELERY_BROKER_URL="redis://redis:6379/0"
CELERY_RESULT_BACKEND="redis://redis:6379/0"

# --- pk integration ---
# Shared with pk (must match ENTEST_API_KEY there). Used to authenticate S2S calls from pk.
PK_API_KEY="change-me-s2s"
# Shared with pk (must match ENTEST_SSO_SECRET there). Used to verify admin SSO JWTs.
PK_SSO_SECRET="change-me-sso"
# Shared with pk (must match ENTEST_WEBHOOK_SECRET there). Used to sign outgoing webhooks.
PK_WEBHOOK_SECRET="change-me-webhook"
# URL on pk that receives attempt-completed webhooks.
PK_WEBHOOK_URL="https://pk.kbtu.kz/api/v1/webhooks/entest/result"
# How long student attempt JWTs are valid.
PK_STUDENT_TOKEN_TTL_MINUTES=60
# Base URL of the entest frontend; used to build the absolute take URL returned to pk.
ENTEST_FRONTEND_URL="https://entest.kbtu.kz"
